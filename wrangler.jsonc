{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "man-night",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dinner.tylermiranda.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "man-night-db",
      "database_id": "6292ee24-8aa6-49fd-82a0-9211245cc916",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_URL": "https://dinner.tylermiranda.com",
    "CLUB_TIMEZONE": "America/Chicago",
    "GCAL_CALENDAR_ID": "cqubssbfpc3ofjf3anej422tec@group.calendar.google.com",
    "GITHUB_REPO": "tylermiranda/man-night"
  }
}
